{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "jsx": "react-jsx", "jsxImportSource": "preact",
    "skipLibCheck": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"], "allowImportingTsExtensions": true
  },
  "include": ["src", "shared"]
}
